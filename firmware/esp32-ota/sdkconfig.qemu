# QEMU profile: network over QEMU's emulated OpenCores Ethernet port.
# Firmware built with this profile does not run on a real ESP32.
#
# ESP-IDF 6 sets up Ethernet through the ethernet_init component. Its QEMU
# option only appears when the internal and SPI Ethernet drivers are off.
CONFIG_EXAMPLE_CONNECT_WIFI=n
CONFIG_EXAMPLE_CONNECT_ETHERNET=y
CONFIG_ETHERNET_INTERNAL_SUPPORT=n
CONFIG_ETHERNET_SPI_SUPPORT=n
CONFIG_ETHERNET_OPENETH_SUPPORT=y
