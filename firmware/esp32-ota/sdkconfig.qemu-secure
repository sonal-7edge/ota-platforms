# QEMU profile with Secure Boot V2 and signed images.
# Firmware built with this profile does not run on a real ESP32.

# Network over QEMU's emulated OpenCores Ethernet port (same as sdkconfig.qemu)
CONFIG_EXAMPLE_CONNECT_WIFI=n
CONFIG_EXAMPLE_CONNECT_ETHERNET=y
CONFIG_EXAMPLE_USE_OPENETH=y
CONFIG_ETH_USE_OPENETH=y

# Secure Boot V2 (RSA-3072) needs ESP32 chip revision v3.0 or later.
# QEMU emulates revision 3. Check the real board's revision before using this there.
CONFIG_ESP32_REV_MIN_3=y

# The bootloader turns on Secure Boot V2 on its first boot: it burns the
# public-key digest into eFuse BLK2 and, from then on, only boots signed images.
CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y

# Sign the bootloader and firmware during the build with the development key.
# The path is relative to firmware/esp32-ota/. Create the key with: make keys
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="../../keys/dev_secure_boot_signing_key.pem"

# Include the signed bootloader in flash_args, so the factory image contains it.
CONFIG_SECURE_BOOT_FLASH_BOOTLOADER_DEFAULT=y
